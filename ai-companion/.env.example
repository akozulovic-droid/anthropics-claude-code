# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used in later phases (admin tasks, Stripe webhooks). Keep secret.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider (used in Phase 3/4) ---
OPENAI_API_KEY=

# --- Stripe (used in Phase 5) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- App ---
# Used for auth email redirect links. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000
