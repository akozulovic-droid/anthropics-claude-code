# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used in later phases (admin tasks, Stripe webhooks). Keep secret.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider ---
# If unset, the app uses a local placeholder image so the creation flow
# still works end-to-end without a paid key.
OPENAI_API_KEY=
# Optional. Defaults to gpt-image-1.
OPENAI_IMAGE_MODEL=
# Optional. Defaults to gpt-4o-mini (used for chat).
OPENAI_CHAT_MODEL=

# --- Stripe (used in Phase 5) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- App ---
# Used for auth email redirect links. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000
